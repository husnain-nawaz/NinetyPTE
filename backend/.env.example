PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Hostinger internal server uses 127.0.0.1; external remote dev uses Hostinger DB host
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_USE_DB_NAME_AS_USER=true
DB_CONNECTION_LIMIT=2

# Feature-isolated databases
DB_AUTH_NAME=ninetypte_auth
DB_ADMIN_NAME=ninetypte_admin
DB_MOCK_CATALOG_NAME=ninetypte_mock_catalog
DB_MOCKS_NAME=ninetypte_mocks
DB_Q_ACAD_NAME=ninetypte_q_acad
DB_Q_CORE_NAME=ninetypte_q_core
DB_PRACTICE_NAME=ninetypte_practice
DB_AI_EVAL_NAME=ninetypte_ai_eval
DB_STATS_NAME=ninetypte_stats
DB_CMS_NAME=ninetypte_cms
DB_MEDIA_NAME=ninetypte_media
DB_BILLING_NAME=ninetypte_billing
DB_PROMO_NAME=ninetypte_promo
DB_NOTIFY_NAME=ninetypte_notify
DB_LOGS_NAME=ninetypte_logs

JWT_SECRET=change_this_to_a_strong_random_secret
GOOGLE_CLIENT_ID=
