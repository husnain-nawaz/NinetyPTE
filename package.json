{
  "name": "ninetypte",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NinetyPTE full-stack PTE preparation platform (Frontend + Express/MySQL API)",
  "main": "backend/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "postinstall": "node backend/scripts/buildFrontend.mjs",
    "build": "npm install --prefix backend --ignore-scripts --no-audit --no-fund && node backend/scripts/buildFrontend.mjs",
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mysql2": "^3.11.5"
  }
}
